# herdr ワークフローの再現に必要な CLI 群
brew "herdr"   # https://herdr.dev — agent multiplexer (0.8.2 時点の設定)
brew "ghq"     # リポジトリ管理 (~/workspace 配下に clone)
brew "gwq"     # git worktree 管理
brew "fzf"     # dev / wt / gsw / new-workspace-picker が使用
brew "jq"      # gwt / プラグイン / hooks が使用
brew "gh"      # GitHub CLI（任意だが推奨）
