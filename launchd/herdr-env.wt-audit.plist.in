<?xml version="1.0" encoding="UTF-8"?>
<!--
  終わった作業のワークツリーを定期的に片付ける（wt-audit --auto）。
  PR が merged/closed、未コミット変更なし、未 push コミットなし、
  エージェントが動いていない space のものだけが対象。
  install.sh --launchd が ~/Library/LaunchAgents/ に置いて launchctl bootstrap する。
  @HOME@ / @BREW_PREFIX@ は install.sh --launchd が埋める（手で置くなら書き換える）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.herdr-env.wt-audit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>wt-audit --auto</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@HOME@/.local/bin:@BREW_PREFIX@/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- 30分ごと。ログイン直後には走らせない（RunAtLoad は付けない）。 -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>@HOME@/.local/state/wt-audit/audit.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.local/state/wt-audit/audit.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
