<?xml version="1.0" encoding="UTF-8"?>
<!--
  ワークツリーの space に出している PR 状態（pr-status プラグインの $pr / $ci / $rv）を定期的に取り直す。
  プラグイン側は起動時・フォーカス時・ワークツリーを開いたときにしか動かないので、
  見ていない space の CI やレビューの変化はこちらで拾う。gh はリポジトリごとに GraphQL 1回。
  install.sh --launchd が ~/Library/LaunchAgents/ に置いて launchctl bootstrap する。
  @HOME@ / @BREW_PREFIX@ は install.sh --launchd が埋める（手で置くなら書き換える）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.herdr-env.herdr-pr-status</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>herdr-pr-status sync --all</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@HOME@/.local/bin:@BREW_PREFIX@/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- 毎分（gh は1回あたり GraphQL 3ポイント、リポジトリごとに1回）。トークンの TTL は30分なので、止まれば古い表示は自然に消える。 -->
  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>@HOME@/.local/state/herdr-pr-status/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.local/state/herdr-pr-status/launchd.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
